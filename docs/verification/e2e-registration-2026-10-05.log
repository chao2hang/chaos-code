    e2e/commit-message-safe-mode.pw.ts        playwright.git.config.ts (project `desktop-chromium`) + playwright.git.config.ts (project `mobile-chromium`)
    e2e/commit-message.pw.ts  playwright.git.config.ts (project `desktop-chromium`) + playwright.git.config.ts (project `mobile-chromium`)
    e2e/diff-undo.pw.ts       playwright.config.ts (project `desktop-chromium`) + playwright.config.ts (project `mobile-chromium`)
    e2e/phone-shell.pw.ts     playwright.config.ts (project `desktop-chromium`) + playwright.config.ts (project `mobile-chromium`)
    e2e/reconnect-snapshot.pw.ts      playwright.config.ts (project `desktop-chromium`) + playwright.config.ts (project `mobile-chromium`)
    e2e/settings-panel.pw.ts  playwright.config.ts (project `desktop-chromium`) + playwright.config.ts (project `mobile-chromium`)
    e2e/static-host.pw.ts     playwright.config.ts (project `desktop-chromium`) + playwright.config.ts (project `mobile-chromium`)
