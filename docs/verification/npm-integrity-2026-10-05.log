          file:     /tmp/npm-integrity-evidence-v74ge5e9/node_modules/chaos-code-linux-x64/bin/chaos.br
          expected: 37fd0e9371cbd5eb41923759f9cc55a2fbc88a3bc2f084fb8bdd40bad676e9c9
          actual:   caacc3f0ae48b5b62d9818533bb2b4d5be6fc52a71a8f35d3b03c015cf3ad282
          These are not the bytes the release build hashed. Re-run the install after
          `npm cache clean --force`; if it repeats, the package you received was
          altered, so please report it instead of installing around it.
        exit=1

