/target
**/*.rs.bk
.DS_Store
.claude_consciousness.m8
.omo/

# Local WSL / probing scripts kept out of history
.wsl_*.sh

# Codegraph local index (database, daemon socket/pid/log) — machine-local
/.codegraph/

# Images the TUI stages under the project's `.chaos` when you paste or attach one
# — machine-local scratch, never repo content. Scoped to `uploads/` rather than
# the whole directory so a future project-scoped `.chaos/` (agents, roles,
# skills) can still be committed deliberately.
/.chaos/uploads/

# Playwright run artifacts: `outputDir` in `apps/chaos-ui/playwright.config.ts`
# and the reporter's default `test-results/` directory.
/.chaos/playwright-results/
/test-results/

# State the Git/commit-form browser suite generates: a throwaway repository it
# commits inside, and the prompt log of the local inference endpoint it starts.
# Both are machine-local; a commit test that wrote into the tracked tree would
# dirty the repository it is testing.
/.chaos/e2e-git-workspace/
/.chaos/e2e-provider/

# Windows-path leaked temp artifacts (accidental redirect targets)
# The colon-looking char is U+F03A (PUA), produced by some Windows shell
# quirk that replaced ':' when a Windows path became a filename.
**/CUsers*
# Python bytecode from the l10n checkers (scripts/check-doc-l10n*.py)
__pycache__/
*.pyc

# Frontend dependencies and build output
apps/chaos-ui/node_modules/
apps/chaos-ui/dist/

# ripgrep that scripts/test-platform.{sh,ps1} downloads when the host has none;
# a fetched binary is machine-local, never repo content.
.platform-tools/
